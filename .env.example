# Default client contract: same-origin calls. Route constants include /api/v1.
VITE_API_BASE_URL=

# Dev proxy target for Vite (KrakenD API Gateway en crm-infra).
VITE_API_PROXY_TARGET=http://localhost:28080

# If you need to call the gateway directly from the browser, switch VITE_API_BASE_URL
# to the absolute URL and ensure KrakenD allows the frontend origin via CORS.
# VITE_API_BASE_URL=http://localhost:28080

# API Versions for service contracts
VITE_AUTH_API_VERSION=v1
VITE_COLLAB_API_VERSION=v1
VITE_MEDIA_API_VERSION=v1
